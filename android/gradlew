# This is a wrapper script for calling Gradle from the command line.

set -e

# Find the project root directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Run Gradle
exec "$SCRIPT_DIR/gradlew.bat" "$@"