#!/bin/bash

# Copyright 2014 The Flutter Authors. All rights reserved.
# Use of this source code is governed by a BSD-style license that can be
# found in the LICENSE file.

# This script is a bridge that allows Flutter to find the Gradle wrapper
# that is included in the Flutter SDK.

set -e

# Find the Flutter SDK
if [ -z "$FLUTTER_ROOT" ]; then
  # Try to find Flutter from the project's local.properties
  if [ -f "local.properties" ]; then
    FLUTTER_ROOT=$(grep "flutter.sdk" local.properties | cut -d'=' -f2)
  fi
fi

# If we still can't find it, check common locations
if [ -z "$FLUTTER_ROOT" ]; then
  if [ -d "/usr/local/flutter" ]; then
    FLUTTER_ROOT="/usr/local/flutter"
  elif [ -d "$HOME/flutter" ]; then
    FLUTTER_ROOT="$HOME/flutter"
  fi
fi

if [ -z "$FLUTTER_ROOT" ]; then
  echo "Error: Cannot find Flutter SDK. Set FLUTTER_ROOT environment variable."
  exit 1
fi

# Use Flutter's built-in Gradle wrapper
exec "$FLUTTER_ROOT/packages/flutter_tools/gradle/gradlew" "$@"